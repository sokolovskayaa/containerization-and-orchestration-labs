+    def _list_cloudnativepg(self) -> list[K8sObjectData]:
+        """Read-only CNPG discovery; resource usage is still computed by KRR."""
+        async def _extract_containers(item: Any) -> list[V1Container]:
+            # CNPG creates Pods directly. Build a local selector, never mutate the CR.
+            item.spec.selector = V1LabelSelector(match_labels={"cnpg.io/cluster": item.metadata.name})
+            loop = asyncio.get_running_loop()
+            pods = await loop.run_in_executor(
+                self.executor,
+                lambda: self.core.list_namespaced_pod(
+                    namespace=item.metadata.namespace,
+                    label_selector=f"cnpg.io/cluster={item.metadata.name}",
+                ),
+            )
+            containers = {}
+            for pod in pods.items:
+                if pod.metadata.deletion_timestamp is None:
+                    for container in pod.spec.containers:
+                        containers[container.name] = container
+            return list(containers.values())
+
+        return self._list_scannable_objects(
+            kind="CloudNativePG",
+            all_namespaces_request=lambda **kwargs: ObjectLikeDict(
+                self.custom_objects.list_cluster_custom_object(
+                    group="postgresql.cnpg.io", version="v1", plural="clusters", **kwargs
+                )
+            ),
+            namespaced_request=lambda **kwargs: ObjectLikeDict(
+                self.custom_objects.list_namespaced_custom_object(
+                    group="postgresql.cnpg.io", version="v1", plural="clusters", **kwargs
+                )
+            ),
+            extract_containers=_extract_containers,
+        )
+
